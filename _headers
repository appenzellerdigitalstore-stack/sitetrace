# Cloudflare Pages headers — applied to every response.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  X-XSS-Protection: 0
  Cross-Origin-Opener-Policy: same-origin

# Short-cache JS during the early-launch phase so updates land without
# users hitting the "immutable" year-long cache. We'll move to content-hashed
# filenames (e.g. i18n.a1b2c3.js) once a build step is in place, then this
# can go back to a long max-age.
# NOTE: the previous immutable + 1-year setting for /js/*.js caused the
# landing page to keep showing raw i18n keys after a dictionary update,
# because the browser still served the previous /js/i18n.js from cache.
/js/*.js
  Cache-Control: public, max-age=300, must-revalidate

# Allow Googlebot to crawl everything; hint that sitemap exists
/sitemap.xml
  Cache-Control: public, max-age=3600
